{
  "name": "stair-lift-register",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-portable.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "db:create": "wrangler d1 create stair-lift-register",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "configure": "node scripts/configure-d1.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  }
}
