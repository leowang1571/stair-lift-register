{
  "name": "stair-lift-register",
  "main": "standalone/worker.mjs",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": ".portable/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stair-lift-register",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
